{
  "manifest_version": 3,
  "name": "DingTalk Wiki Markdown Exporter",
  "version": "0.1.1",
  "description": "Export DingTalk wiki documents to Markdown.",
  "permissions": ["activeTab", "downloads", "tabs", "webNavigation"],
  "host_permissions": [
    "https://docs.dingtalk.com/*",
    "https://alidocs.dingtalk.com/*"
  ],
  "action": {
    "default_title": "导出钉钉文档",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.dingtalk.com/*",
        "https://alidocs.dingtalk.com/*"
      ],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "contentScript.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
